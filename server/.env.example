# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Email delivery
# With Gmail, use the address below and a Google App Password (not your normal password).
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
CONTACT_RECIPIENT=jcomendador120@gmail.com

# AI portfolio assistant. Keep this key server-side; never prefix it with VITE_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional: set these to use another SMTP provider instead of Gmail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Keep Cloudinary credentials server-side. Never expose the API secret with a VITE_ prefix.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
