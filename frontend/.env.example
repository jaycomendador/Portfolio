# Add these in Vercel → Project Settings → Environment Variables.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
CONTACT_RECIPIENT=jcomendador120@gmail.com
CLIENT_ORIGIN=https://your-portfolio.vercel.app
# Optional custom SMTP provider settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Cloudinary client-side unsigned upload configuration.
# Create an unsigned preset in Cloudinary and restrict allowed formats/folder there.
VITE_CLOUDINARY_CLOUD_NAME=noizty5f
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Set these in Vercel Project Settings -> Environment Variables for the AI chat API.
# Never use a VITE_ prefix for the secret API key.
OPENAI_API_KEY=your-254873847329468
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Set in Vercel for server-side API functions; never add a VITE_ prefix.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
